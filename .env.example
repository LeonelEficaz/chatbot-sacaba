# Copia este archivo como .env y completa los valores en tu equipo.
# En el hosting estas variables se configuran en el panel del servicio,
# nunca se sube el archivo .env al repositorio.

# Clave de sesión de Flask (obligatoria en producción: cadena larga y aleatoria)
SECRET_KEY=cambia_esta_clave_por_una_aleatoria_larga

OPENAI_API_KEY=tu_clave_de_openai
OPENAI_MODEL=gpt-4o-mini
OPENAI_AUDIO_MODEL=whisper-1

# Token de Hugging Face
HF_API_TOKEN=tu_token_de_huggingface

# Google Gemini
GEMINI_API_KEY=tu_clave_de_gemini
GEMINI_MODEL=gemini-1.5-flash

# Glosbe Dictionary API, si se habilita en el proyecto
GLOSBLE_API_KEY=tu_clave_de_glosbe

# IA de respaldo sin clave (se usa cuando OpenAI no tiene creditos).
# El plan gratuito responde 1 consulta cada 30 s por IP; para respuestas
# ilimitadas conviene cargar creditos en OpenAI o una clave gratuita de Gemini.
SACABA_FREE_AI=1
SACABA_FREE_AI_URL=https://text.pollinations.ai/openai
SACABA_FREE_AI_MODEL=openai-fast
SACABA_FREE_AI_TIMEOUT=40

# SACABA_DISABLE_AI=1 desactiva toda la IA y deja solo el motor local
